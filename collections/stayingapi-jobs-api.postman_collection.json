          "request": {
            "name": "Poll an async job (always 0 credits).",
            "description": {
              "content": "Poll until status is terminal (completed | failed). While pending/running the response carries a Retry-After header. Enforces jobs.user_id == caller; unknown/not-owned/expired → job_not_found (404).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jobs",
                ":jobId"
              ],
